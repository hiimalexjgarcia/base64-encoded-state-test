{
  "name": "linkboard",
  "version": "0.3.1",
  "description": "A vanilla TypeScript sticky-note board that stores all state in the URL hash.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"vite.config.ts\" \"*.{js,mjs}\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"vite.config.ts\" \"*.{js,mjs}\" --fix",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiimalexjgarcia/linkboard.git"
  },
  "keywords": [
    "sticky-notes",
    "typescript",
    "url-state",
    "base64url",
    "vite",
    "no-backend"
  ],
  "author": "hiimalexjgarcia",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/hiimalexjgarcia/linkboard/issues"
  },
  "homepage": "https://github.com/hiimalexjgarcia/linkboard#readme",
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "nanoid": "^6.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "deepmerge": "4.1.2",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
